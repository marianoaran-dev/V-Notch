<Window x:Class="VNotch.PiggyAlertSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piggy Bank Alerts"
        Width="600"
        Height="560"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource SFProDisplay}">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FC050505"/>
        <SolidColorBrush x:Key="CardBrush" Color="#F20C0C0C"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA0A8"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#D8DADE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F07FA8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{DynamicResource SFProDisplay}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxFrame"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    BorderBrush="#42FFFFFF"
                                    Background="#12FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 0,3.8 L 2.8,6.6 L 8.4,0"
                                      Width="10"
                                      Height="8"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="White"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxFrame" Property="Background" Value="#34363A"/>
                                <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="#92FFFFFF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThresholdCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#34FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="4,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#24FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#32FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,34,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot">
                            <Border x:Name="ComboShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <ContentPresenter x:Name="SelectionPresenter"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      IsHitTestVisible="False"/>
                                    <Path x:Name="Chevron"
                                          Data="M 0,0 L 4,4 L 8,0"
                                          Stroke="#C8FFFFFF"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                                </Grid>
                            </Border>

                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,6,0,0"
                                        MinWidth="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}"
                                        Background="#F70A0A0A"
                                        BorderBrush="#3AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboShell" Property="Background" Value="#191919"/>
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="#56FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboShell" Property="Background" Value="#1C1C1C"/>
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="#72FFFFFF"/>
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4" CenterY="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FFF9A9C4"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Grid Width="14" Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path Data="M 2.5,2.5 L 11.5,11.5 M 11.5,2.5 L 2.5,11.5"
                                      Stroke="#F2FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseShell" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="CloseShell" Property="BorderBrush" Value="#4AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseShell" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="24"
            Padding="24,0,24,20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.58"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    Padding="0,14,0,8"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Height="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="28"
                           Height="28"
                           Source="pack://application:,,,/Assets/piggy-panel-pink.png"
                           VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PIGGY BANK ALERTS"
                                   FontSize="16.5"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Quota and banked reset notifications"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource CloseButton}"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Padding="18,14"
                    Margin="0,8,0,12">
                <StackPanel>
                    <CheckBox x:Name="EnableNotificationsCheck"
                              Content="Enable Piggy Bank notifications"
                              Checked="MasterNotificationCheck_Changed"
                              Unchecked="MasterNotificationCheck_Changed"/>
                    <TextBlock Text="Alerts use the same V-Notch tray notification path and stay saved between app versions."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="28,3,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="UsageAlertsPanel">
                        <CheckBox x:Name="UsageAlertsCheck"
                                  Content="Weekly alerts"
                                  Checked="UsageAlertsCheck_Changed"
                                  Unchecked="UsageAlertsCheck_Changed"/>
                        <TextBlock Text="Notify once when weekly remaining quota reaches a selected threshold."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="28,3,0,14"/>

                        <WrapPanel Margin="28,0,0,0" VerticalAlignment="Center">
                            <CheckBox x:Name="Alert50Check" Content="50%" Style="{StaticResource ThresholdCheck}"/>
                            <CheckBox x:Name="Alert25Check" Content="25%" Style="{StaticResource ThresholdCheck}"/>
                            <CheckBox x:Name="Alert10Check" Content="10%" Style="{StaticResource ThresholdCheck}"/>
                        </WrapPanel>

                        <Grid Margin="28,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="CustomAlertCheck"
                                      Content="Custom threshold"
                                      VerticalAlignment="Center"
                                      Checked="CustomAlertCheck_Changed"
                                      Unchecked="CustomAlertCheck_Changed"/>
                            <TextBox x:Name="CustomAlertText"
                                     Grid.Column="1"
                                     Width="58"
                                     Height="30"
                                     Margin="12,0,0,0"
                                     HorizontalContentAlignment="Right"
                                     PreviewTextInput="CustomAlertText_PreviewTextInput"/>
                            <TextBlock Grid.Column="2"
                                       Text="%"
                                       Foreground="{StaticResource SoftBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="7,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="BankedAlertsPanel">
                        <CheckBox x:Name="BankedExpiryCheck"
                                  Content="Banked reset expiry alerts"
                                  Checked="BankedExpiryCheck_Changed"
                                  Unchecked="BankedExpiryCheck_Changed"/>
                        <TextBlock Text="Get one reminder before an available banked reset expires."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="28,3,0,13"/>
                        <Grid Margin="28,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Remind me"
                                       Foreground="{StaticResource SoftBrush}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="BankedReminderCombo"
                                      Grid.Column="1"
                                      Width="170"
                                      Height="32"
                                      Margin="12,0,0,0"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="1 hour before" Tag="1"/>
                                <ComboBoxItem Content="6 hours before" Tag="6"/>
                                <ComboBoxItem Content="24 hours before" Tag="24"/>
                                <ComboBoxItem Content="48 hours before" Tag="48"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="NotificationSoundCheck"
                          Content="Play notification sound"
                          Margin="4,1,0,0"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TestButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Content="Send test"
                        Style="{StaticResource ActionButton}"
                        Click="Test_Click"/>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Margin="0,0,8,0"
                        Style="{StaticResource ActionButton}"
                        Click="Cancel_Click"/>
                <Button Grid.Column="2"
                        Content="Save"
                        MinWidth="82"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
