<Window x:Class="VNotch.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V-Notch Spotlight"
        Width="720"
        SizeToContent="Height"
        MaxHeight="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        AutomationProperties.Name="V-Notch Spotlight">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#92FFFFFF"/>
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#5EFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#73D5F1"/>

        <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F817191D" Offset="0"/>
            <GradientStop Color="#FB101216" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IconSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1FFFFFFF" Offset="0"/>
            <GradientStop Color="#0CFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SelectedItemBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2473D5F1" Offset="0"/>
            <GradientStop Color="#12FFFFFF" Offset="0.55"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="KeyBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="ItemSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="13,9">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="SelectionAccent"
                                    Width="3"
                                    Height="28"
                                    Margin="0,0,0,0"
                                    CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#73D5F1"
                                                      BlurRadius="9"
                                                      ShadowDepth="0"
                                                      Opacity="0.45"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#0EFFFFFF"/>
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SelectedItemBrush}"/>
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#1FFFFFFF"/>
                                <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            CornerRadius="20"
            Background="{StaticResource ShellBrush}"
            BorderBrush="#2DFFFFFF"
            BorderThickness="1"
            ClipToBounds="False"
            Opacity="0"
            RenderTransformOrigin="0.5,0.12">
        <Border.Effect>
            <DropShadowEffect Color="#020408" BlurRadius="42" ShadowDepth="14" Opacity="0.78"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="0.98" ScaleY="0.98"/>
        </Border.RenderTransform>

        <Grid x:Name="ShellContent"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentTranslate" Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="94"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search field -->
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        CornerRadius="11"
                        Background="{StaticResource IconSurfaceBrush}"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="18"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Grid Grid.Column="1" Margin="4,0,18,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"
                             FontFamily="{StaticResource SFProDisplay}"
                             FontSize="24"
                             FontWeight="Medium"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             SelectionBrush="#6A73D5F1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,2,0,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search apps and files"/>
                    <TextBlock x:Name="PlaceholderText"
                               Text="Search apps and files"
                               FontFamily="{StaticResource SFProDisplay}"
                               FontSize="24"
                               FontWeight="Medium"
                               Foreground="#58FFFFFF"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="SPOTLIGHT"
                               Margin="0,0,11,0"
                               FontFamily="{StaticResource SFProText}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#42FFFFFF"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource KeyBadgeStyle}">
                        <TextBlock Text="ESC"
                                   FontFamily="{StaticResource SFProText}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#82FFFFFF"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Results and keyboard help appear only after the user starts searching. -->
            <Border x:Name="ContentRegion"
                    Grid.Row="1"
                    BorderBrush="#1CFFFFFF"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="25,0,25,0">
                        <TextBlock x:Name="ResultsHeading"
                                   Text="RESULTS"
                                   FontFamily="{StaticResource SFProText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#67FFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ResultCountText"
                                   HorizontalAlignment="Right"
                                   FontFamily="{StaticResource SFProText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ResultsList"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="440"
                                 AlternationCount="20"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                                 AutomationProperties.Name="Search results">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="48"
                                          AutomationProperties.Name="{Binding Title}"
                                          AutomationProperties.HelpText="{Binding Subtitle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="10"
                                                Background="{StaticResource IconSurfaceBrush}"
                                                BorderBrush="#14FFFFFF"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left">
                                            <Grid>
                                                <Image Source="{Binding Icon}"
                                                       Width="27"
                                                       Height="27"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="FallbackGlyph"
                                                           Text="{Binding Glyph}"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="18"
                                                           Foreground="#C8FFFFFF"
                                                           Visibility="Collapsed"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="2,0,16,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{StaticResource SFProDisplay}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Margin="0,2,0,0"
                                                       FontFamily="{StaticResource SFProText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border x:Name="OpenBadge"
                                                Grid.Column="2"
                                                Style="{StaticResource KeyBadgeStyle}"
                                                Padding="8,4"
                                                Opacity="0">
                                            <TextBlock Text="&#x21B5;"
                                                       FontFamily="{StaticResource SFProText}"
                                                       FontSize="12"
                                                       Foreground="#AFFFFFFF"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter TargetName="OpenBadge" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid x:Name="StatusPanel"
                              MinHeight="112"
                              Margin="24,4,24,14"
                              Visibility="Collapsed"
                              AutomationProperties.LiveSetting="Polite">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40"
                                        Height="40"
                                        Margin="0,0,0,11"
                                        CornerRadius="12"
                                        Background="#0FFFFFFF"
                                        BorderBrush="#16FFFFFF"
                                        BorderThickness="1">
                                    <TextBlock x:Name="StatusGlyph"
                                               Text="&#xE721;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="17"
                                               Foreground="#8FFFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="StatusTitle"
                                           FontFamily="{StaticResource SFProDisplay}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#D8FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusHint"
                                           MaxWidth="520"
                                           Margin="0,4,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="16,0"
                            BorderBrush="#15FFFFFF"
                            BorderThickness="0,1,0,0">
                        <Grid Margin="9,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x2191; &#x2193;"
                                           FontSize="12"
                                           Foreground="#A6FFFFFF"/>
                                <TextBlock x:Name="NavigateHintText"
                                           Text="Navigate"
                                           Margin="7,0,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="10"
                                           Foreground="#60FFFFFF"/>
                                <Border Width="1" Height="13" Margin="13,0" Background="#1FFFFFFF"/>
                                <TextBlock Text="&#x21B5;"
                                           FontSize="13"
                                           Foreground="#A6FFFFFF"/>
                                <TextBlock x:Name="OpenHintText"
                                           Text="Open"
                                           Margin="7,0,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="10"
                                           Foreground="#60FFFFFF"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyBadgeStyle}" Padding="6,3">
                                    <TextBlock Text="ESC"
                                               FontFamily="{StaticResource SFProText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#78FFFFFF"/>
                                </Border>
                                <TextBlock x:Name="CloseHintText"
                                           Text="Close"
                                           Margin="7,0,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="10"
                                           Foreground="#60FFFFFF"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
